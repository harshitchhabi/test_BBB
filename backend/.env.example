PORT=8080
# Must match packages/game-engine's INTERNAL_BROADCAST_SECRET (set on the
# frontend's server environment) — generate a long random value per
# deployment, never commit the real one.
INTERNAL_BROADCAST_SECRET=change-me
# Required for the timer sweep (auto-closing an auction lot or city
# auction whose countdown ran out) to work at all — without it the sweep
# silently errors on every tick and every lot/auction has to be closed
# manually by a moderator. Same database as the frontend's DATABASE_URL.
# URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://user:password@host:5432/dbname
