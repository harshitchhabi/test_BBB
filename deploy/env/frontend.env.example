# Copy to /etc/bricksbybid/frontend.env on the server (NOT into the repo
# checkout — EnvironmentFile in bbb-frontend.service points there
# directly, and keeping it outside /opt/bricksbybid means a `git pull`
# during a deploy can never touch or overwrite it).
#   sudo mkdir -p /etc/bricksbybid && sudo chmod 700 /etc/bricksbybid
#   sudo cp deploy/env/frontend.env.example /etc/bricksbybid/frontend.env
#   sudo chown bbb:bbb /etc/bricksbybid/frontend.env
#   sudo chmod 600 /etc/bricksbybid/frontend.env
# Then edit the real file and fill in every value below.

# Local Postgres on this same instance (see deploy/README.md's DB setup
# step for creating this role/database). URL-encode any special
# characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://bbb_app:CHANGE_ME@localhost:5432/bricks_by_bid_prod

# Generate with: openssl rand -hex 32
# Different from INTERNAL_BROADCAST_SECRET below - this one signs the
# session cookie only.
SESSION_SECRET=CHANGE_ME

# Generate with: openssl rand -hex 32
# Must be byte-for-byte identical in /etc/bricksbybid/backend.env - it's
# the one secret both processes share, used both for
# POST /internal/broadcast and for signing/verifying the WebSocket
# join ticket (packages/common/src/ws-ticket.ts).
INTERNAL_BROADCAST_SECRET=CHANGE_ME

# Same-box backend, not exposed externally - nginx only proxies /ws
# (see deploy/nginx/bricksbybid.conf), the frontend talks to it directly.
BACKEND_INTERNAL_URL=http://localhost:8080

# The browser connects here directly (through nginx's /ws location) -
# wss:// (not ws://) once TLS is live, and the real public domain, not
# localhost.
NEXT_PUBLIC_WS_URL=wss://bricksbybid.dreammerchantsevent.me/ws

# Safe to enable ONLY because deploy/nginx/bricksbybid.conf sets
# X-Forwarded-For to $remote_addr (overwriting, never appending) - if
# you ever move this behind a different proxy, confirm it does the same
# before flipping this on, or the login rate limiter's secondary
# per-address layer trusts a spoofable header again.
TRUST_PROXY_HEADERS=true
