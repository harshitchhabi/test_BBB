# Copy to /etc/bricksbybid/backend.env on the server (see the same
# instructions at the top of deploy/env/frontend.env.example).

PORT=8080

# Must be byte-for-byte identical to frontend.env's INTERNAL_BROADCAST_SECRET.
INTERNAL_BROADCAST_SECRET=CHANGE_ME

# Required for the timer sweep (auto-closing an expired auction lot or
# city auction) to work at all. Same database as frontend.env's
# DATABASE_URL, same role is fine - the sweep only needs the same
# read/write access every other mutation already uses.
DATABASE_URL=postgresql://bbb_app:CHANGE_ME@localhost:5432/bricks_by_bid_prod

TIMER_SWEEP_INTERVAL_MS=2000
ENABLE_TIMER_SWEEP=true
