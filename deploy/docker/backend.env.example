# Copy to deploy/docker/backend.env (NOT into git). Read by the backend
# container at runtime.

PORT=8080

# Must be byte-for-byte identical to frontend.env's INTERNAL_BROADCAST_SECRET.
INTERNAL_BROADCAST_SECRET=CHANGE_ME

# "postgres" = the Postgres service's name on the compose network.
DATABASE_URL=postgresql://bbb_app:CHANGE_ME@postgres:5432/bricks_by_bid_prod

TIMER_SWEEP_INTERVAL_MS=2000
ENABLE_TIMER_SWEEP=true
