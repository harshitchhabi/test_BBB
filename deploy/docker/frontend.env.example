# Copy to deploy/docker/frontend.env (NOT into git). Read by the
# frontend container at runtime (docker-compose.yml's env_file:).

# "postgres" is the Postgres service's name on the compose network, not
# localhost - Docker's internal DNS resolves it. Password must match
# deploy/docker/.env's POSTGRES_PASSWORD.
DATABASE_URL=postgresql://bbb_app:CHANGE_ME@postgres:5432/bricks_by_bid_prod

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Generate with: openssl rand -hex 32 - must be byte-for-byte identical
# to backend.env's INTERNAL_BROADCAST_SECRET.
INTERNAL_BROADCAST_SECRET=CHANGE_ME

# "backend" is the relay service's name on the compose network.
BACKEND_INTERNAL_URL=http://backend:8080

# Safe because the host's nginx (deploy/nginx/bricksbybid.conf) sets
# X-Forwarded-For to $remote_addr, overwriting rather than appending -
# same reasoning as the native deployment's frontend.env.
TRUST_PROXY_HEADERS=true
