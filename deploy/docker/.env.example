# Copy to deploy/docker/.env (NOT into git - this holds real secrets).
# Read by docker-compose.yml itself (interpolated into ${...}
# references); frontend.env/backend.env below are separate files read by
# the containers themselves.

# Also becomes DATABASE_URL's password in frontend.env/backend.env below
# - keep them in sync.
POSTGRES_PASSWORD=CHANGE_ME

# Passed as a build ARG to the frontend image - inlined into the client
# bundle at build time (see frontend/Dockerfile), not read at container
# runtime.
NEXT_PUBLIC_WS_URL=wss://bricksbybid.dreammerchantsevent.me/ws
