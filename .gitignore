# reference-only clone of the legacy repo — never part of this project's history
/my-bid/

# dependencies
node_modules/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env*.local
!.env.example

# deploy/docker/*.env.example are templates (tracked); the real files a
# deployer copies them to (frontend.env, backend.env, .env) hold actual
# secrets and must never be committed - "frontend.env"/"backend.env"
# don't match the .env pattern above (only the exact ".env" filename
# does), so they need their own rule.
deploy/docker/*.env

# next.js
.next/
out/
.vercel

# build
build/
dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
