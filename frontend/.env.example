# Same Postgres the packages/db workspace connects to.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bricks_by_bid_dev

# Signs the session cookie (Task 1: username/password login replaced
# Google OAuth). Any long random string — generate one per deployment,
# never reuse across events.
SESSION_SECRET=

# Where the WebSocket relay (backend/) lives, and the shared secret
# game-engine uses to authenticate POST /internal/broadcast to it. Must
# match backend/.env's INTERNAL_BROADCAST_SECRET exactly.
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_BROADCAST_SECRET=change-me

# Public — the browser connects directly to the relay's WS endpoint.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
